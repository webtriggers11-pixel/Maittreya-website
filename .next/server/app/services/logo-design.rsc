rand.","Fast turnaround time — no endless waiting.","Unlimited revisions until you are fully satisfied.","Affordable packages for every budget.","Brand-focused approach — not cookie-cutter templates.","Modern and trendy designs that stand out."],"faqs":[["Can a logo be copyrighted in India?","A logo can be protected under the India Copyright Act as a work of artistic creation."],["What are the steps to design a logo?","Understand the brand, research the market, develop logo concepts, get feedback, refine, present and deliver the final files."],["What are the three rules of logo designing?","Keep it simple, make it relevant to your brand and audience, and ensure its versatility across all sizes and media."],["What makes a logo successful?","A successful logo is memorable, unique, versatile, and clearly communicates the brand's essence. The best test is whether your customers can describe it accurately."]]}}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","services","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","services","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/7e02b16a42d3387e.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"children":[["$","$L6",null,{}],["$","main",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undef